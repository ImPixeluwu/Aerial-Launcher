+++ b/src/lib/parsers/friends.test.ts
@@ -0,0 +1,198 @@
+import type { FriendsLists } from '../../types/friends-list'
+
+import { describe, expect, it } from 'vitest'
+
+import {
+  applyFriendsAction,
+  buildAccountIdsQuery,
+  chunk,
+  filterFriends,
+  getFriendDisplayName,
+  getFriendsSummaryAccountIds,
+  isEpicAccountId,
+  normalizeFriendsSummary,
+} from './friends'
+
+const ids = {
+  alpha: 'a'.repeat(32),
+  bravo: 'b'.repeat(32),
+  charlie: 'c'.repeat(32),
+  delta: 'd'.repeat(32),
+  echo: 'e'.repeat(32),
+}
+
+describe('normalizeFriendsSummary', () => {
+  const summary = {
+    friends: [
+      { accountId: ids.bravo, created: '2024-01-01T00:00:00Z', mutual: 3 },
+      { accountId: ids.alpha },
+    ],
+    incoming: [{ accountId: ids.charlie }],
+    outgoing: [{ accountId: ids.delta }],
+    blocklist: [{ accountId: ids.echo }],
+  }
+  const names = {
+    [ids.alpha]: 'alpha',
+    [ids.bravo]: 'Bravo',
+    [ids.charlie]: 'Charlie',
+    [ids.delta]: 'Delta',
+    [ids.echo]: 'Echo',
+  }
+
+  it('returns the four lists sorted by name, with their names', () => {
+    const result = normalizeFriendsSummary(summary, names)
+
+    expect(result.success).toBe(true)
+    expect(result.friends.map((entry) => entry.displayName)).toEqual([
+      'alpha',
+      'Bravo',
+    ])
+    expect(result.friends[1]).toEqual({
+      accountId: ids.bravo,
+      displayName: 'Bravo',
+      created: '2024-01-01T00:00:00Z',
+      mutual: 3,
+    })
+    expect(result.incoming[0].displayName).toBe('Charlie')
+    expect(result.outgoing[0].displayName).toBe('Delta')
+    expect(result.blocked[0].displayName).toBe('Echo')
+  })
+
+  it('drops duplicated ids and entries without an id', () => {
+    const result = normalizeFriendsSummary(
+      {
+        friends: [
+          { accountId: ids.alpha },
+          { accountId: ids.alpha },
+          {} as { accountId: string },
+        ],
+      },
+      names,
+    )
+
+    expect(result.friends).toHaveLength(1)
+    expect(result.incoming).toEqual([])
+    expect(result.blocked).toEqual([])
+  })
+
+  it('collects every id once to resolve the names', () => {
+    expect(
+      getFriendsSummaryAccountIds({
+        ...summary,
+        incoming: [{ accountId: ids.alpha }],
+      }).toSorted(),
+    ).toEqual([ids.alpha, ids.bravo, ids.delta, ids.echo])
+  })
+
+  it('puts entries without a name last', () => {
+    const result = normalizeFriendsSummary(summary, { [ids.bravo]: 'Bravo' })
+
+    expect(result.friends.map((entry) => entry.accountId)).toEqual([
+      ids.bravo,
+      ids.alpha,
+    ])
+  })
+})
+
+describe('getFriendDisplayName', () => {
+  it('uses a placeholder for empty names, the id or a hex id', () => {
+    expect(getFriendDisplayName(ids.alpha, '')).toBeNull()
+    expect(getFriendDisplayName(ids.alpha, '   ')).toBeNull()
+    expect(getFriendDisplayName(ids.alpha, undefined)).toBeNull()
+    expect(getFriendDisplayName(ids.alpha, ids.alpha.toUpperCase())).toBeNull()
+    expect(getFriendDisplayName(ids.alpha, ids.bravo)).toBeNull()
+  })
+
+  it('keeps a normal name', () => {
+    expect(getFriendDisplayName(ids.alpha, ' Player One ')).toBe('Player One')
+  })
+})
+
+describe('helpers', () => {
+  it('splits 250 ids into batches of 100', () => {
+    const list = Array.from({ length: 250 }, (_, index) => `${index}`)
+
+    expect(chunk(list, 100).map((batch) => batch.length)).toEqual([
+      100, 100, 50,
+    ])
+  })
+
+  it('repeats the accountId key in the names query', () => {
+    expect(buildAccountIdsQuery(['a', 'b'])).toBe('accountId=a&accountId=b')
+  })
+
+  it('recognises account ids in any case', () => {
+    expect(isEpicAccountId('0123456789abcdef0123456789ABCDEF')).toBe(true)
+    expect(isEpicAccountId(' 0123456789abcdef0123456789abcdef ')).toBe(true)
+    expect(isEpicAccountId('0123456789abcdef')).toBe(false)
+    expect(isEpicAccountId('g'.repeat(32))).toBe(false)
+    expect(isEpicAccountId('PlayerOne')).toBe(false)
+  })
+})
+
+describe('filterFriends', () => {
+  const entries = normalizeFriendsSummary(
+    { friends: [{ accountId: ids.alpha }, { accountId: ids.bravo }] },
+    { [ids.alpha]: 'Alpha Wolf', [ids.bravo]: 'Bravo' },
+  ).friends
+
+  it('finds by part of the name or the id, ignoring case', () => {
+    expect(filterFriends(entries, 'WOLF').map((e) => e.accountId)).toEqual([
+      ids.alpha,
+    ])
+    expect(filterFriends(entries, 'BBB').map((e) => e.accountId)).toEqual([
+      ids.bravo,
+    ])
+  })
+
+  it('returns the whole list for an empty query', () => {
+    expect(filterFriends(entries, '')).toBe(entries)
+    expect(filterFriends(entries, '   ')).toBe(entries)
+  })
+})
+
+describe('applyFriendsAction', () => {
+  const lists: FriendsLists = normalizeFriendsSummary(
+    {
+      friends: [{ accountId: ids.alpha }],
+      incoming: [{ accountId: ids.bravo }],
+      outgoing: [{ accountId: ids.charlie }],
+      blocklist: [{ accountId: ids.delta }],
+    },
+    {
+      [ids.alpha]: 'Alpha',
+      [ids.bravo]: 'Bravo',
+      [ids.charlie]: 'Charlie',
+      [ids.delta]: 'Delta',
+    },
+  )
+
+  it('moves an accepted request to the friends', () => {
+    const result = applyFriendsAction(lists, 'accept', ids.bravo)
+
+    expect(result.incoming).toEqual([])
+    expect(result.friends.map((entry) => entry.displayName)).toEqual([
+      'Alpha',
+      'Bravo',
+    ])
+  })
+
+  it('moves a blocked friend to the blocked list', () => {
+    const result = applyFriendsAction(lists, 'block', ids.alpha)
+
+    expect(result.friends).toEqual([])
+    expect(result.blocked.map((entry) => entry.displayName)).toEqual([
+      'Alpha',
+      'Delta',
+    ])
+  })
+
+  it('removes the entry from its list for the other actions', () => {
+    expect(applyFriendsAction(lists, 'remove', ids.alpha).friends).toEqual([])
+    expect(applyFriendsAction(lists, 'reject', ids.bravo).incoming).toEqual([])
+    expect(applyFriendsAction(lists, 'cancel', ids.charlie).outgoing).toEqual(
+      [],
+    )
+    expect(applyFriendsAction(lists, 'unblock', ids.delta).blocked).toEqual([])
+  })
+})
diff --git a/src/lib/parsers/friends.ts b/src/lib/parsers/friends.ts
new file mode 100644
index 0000000..6bd536f
--- /dev/null
+++ b/src/lib/parsers/friends.ts
@@ -0,0 +1,245 @@
+import type {
+  FriendsActionType,
+  FriendsEntry,
+  FriendsLists,
+  FriendsListType,
+  FriendsSummary,
+} from '../../types/friends-list'
+import type {
+  FriendsSummaryEntry,
+  FriendsSummaryResponse,
+} from '../../types/services/friends'
+
+import { friendsListTypes } from '../../config/constants/friends'
+
+/**
+ * Pure helpers of the Epic friends page, shared by the main process and the
+ * renderer.
+ */
+
+const accountIdPattern = /^[0-9a-f]{32}$/i
+
+export function isEpicAccountId(value: string) {
+  return accountIdPattern.test(value.trim())
+}
+
+/**
+ * Epic sometimes returns no name, or the account id as the name: those show
+ * a placeholder instead (null).
+ */
+export function getFriendDisplayName(
+  accountId: string,
+  displayName?: string | null,
+) {
+  const name = displayName?.trim() ?? ''
+
+  if (
+    name === '' ||
+    name.toLowerCase() === accountId.toLowerCase() ||
+    accountIdPattern.test(name)
+  ) {
+    return null
+  }
+
+  return name
+}
+
+export function chunk<T>(list: Array<T>, size: number) {
+  const result: Array<Array<T>> = []
+
+  for (let index = 0; index < list.length; index += size) {
+    result.push(list.slice(index, index + size))
+  }
+
+  return result
+}
+
+/**
+ * `accountId=a&accountId=b`: the account service wants the key repeated,
+ * not the `accountId[]=` that axios builds from an array.
+ */
+export function buildAccountIdsQuery(accountIds: Array<string>) {
+  return accountIds
+    .map((accountId) => `accountId=${encodeURIComponent(accountId)}`)
+    .join('&')
+}
+
+export function compareFriendsEntries(
+  entryA: FriendsEntry,
+  entryB: FriendsEntry,
+) {
+  // Unnamed entries go last
+  if (entryA.displayName === null || entryB.displayName === null) {
+    if (entryA.displayName === entryB.displayName) {
+      return entryA.accountId.localeCompare(entryB.accountId)
+    }
+
+    return entryA.displayName === null ? 1 : -1
+  }
+
+  return (
+    entryA.displayName.localeCompare(entryB.displayName, undefined, {
+      sensitivity: 'base',
+    }) || entryA.accountId.localeCompare(entryB.accountId)
+  )
+}
+
+export function createEmptyFriendsLists(): FriendsLists {
+  return {
+    friends: [],
+    incoming: [],
+    outgoing: [],
+    blocked: [],
+  }
+}
+
+export function createEmptyFriendsSummary(): FriendsSummary {
+  return {
+    success: true,
+    ...createEmptyFriendsLists(),
+  }
+}
+
+function summaryLists(
+  summary: FriendsSummaryResponse,
+): Record<FriendsListType, Array<Partial<FriendsSummaryEntry>>> {
+  return {
+    friends: summary.friends ?? [],
+    incoming: summary.incoming ?? [],
+    outgoing: summary.outgoing ?? [],
+    blocked: summary.blocklist ?? [],
+  }
+}
+
+/**
+ * Every account id of the summary, once, to resolve their names.
+ */
+export function getFriendsSummaryAccountIds(
+  summary: FriendsSummaryResponse,
+) {
+  const accountIds = new Set<string>()
+
+  Object.values(summaryLists(summary)).forEach((list) =>
+    list.forEach((entry) => {
+      if (entry?.accountId) {
+        accountIds.add(entry.accountId)
+      }
+    }),
+  )
+
+  return [...accountIds]
+}
+
+export function normalizeFriendsSummary(
+  summary: FriendsSummaryResponse,
+  names: Record<string, string>,
+): FriendsSummary {
+  const result = createEmptyFriendsSummary()
+  const lists = summaryLists(summary)
+
+  friendsListTypes.forEach((type) => {
+    const seen = new Set<string>()
+
+    result[type] = lists[type]
+      .filter((entry) => {
+        if (!entry?.accountId || seen.has(entry.accountId)) {
+          return false
+        }
+
+        seen.add(entry.accountId)
+
+        return true
+      })
+      .map((entry) => {
+        const accountId = entry.accountId as string
+
+        return {
+          accountId,
+          displayName: getFriendDisplayName(accountId, names[accountId]),
+          created: entry.created ?? null,
+          mutual: typeof entry.mutual === 'number' ? entry.mutual : null,
+        }
+      })
+      .toSorted(compareFriendsEntries)
+  })
+
+  return result
+}
+
+export function filterFriends(entries: Array<FriendsEntry>, query: string) {
+  const value = query.trim().toLowerCase()
+
+  if (value === '') {
+    return entries
+  }
+
+  return entries.filter(
+    (entry) =>
+      entry.accountId.toLowerCase().includes(value) ||
+      (entry.displayName?.toLowerCase().includes(value) ?? false),
+  )
+}
+
+/**
+ * The list a successful action leaves, without reloading the summary.
+ * `add` is not handled here: the page reloads to show the new request.
+ */
+export function applyFriendsAction(
+  lists: FriendsLists,
+  type: Exclude<FriendsActionType, 'add'>,
+  accountId: string,
+): FriendsLists {
+  const without = (list: Array<FriendsEntry>) =>
+    list.filter((entry) => entry.accountId !== accountId)
+  const find = () =>
+    friendsListTypes
+      .map((listType) => lists[listType])
+      .flat()
+      .find((entry) => entry.accountId === accountId) ?? {
+      accountId,
+      displayName: null,
+      created: null,
+      mutual: null,
+    }
+
+  switch (type) {
+    case 'accept': {
+      const entry = lists.incoming.find(
+        (current) => current.accountId === accountId,
+      )
+
+      return {
+        ...lists,
+        incoming: without(lists.incoming),
+        friends: entry
+          ? [...without(lists.friends), entry].toSorted(compareFriendsEntries)
+          : lists.friends,
+      }
+    }
+
+    case 'block': {
+      const entry = find()
+
+      return {
+        friends: without(lists.friends),
+        incoming: without(lists.incoming),
+        outgoing: without(lists.outgoing),
+        blocked: [...without(lists.blocked), entry].toSorted(
+          compareFriendsEntries,
+        ),
+      }
+    }
+
+    case 'remove':
+      return { ...lists, friends: without(lists.friends) }
+
+    case 'reject':
+      return { ...lists, incoming: without(lists.incoming) }
+
+    case 'cancel':
+      return { ...lists, outgoing: without(lists.outgoing) }
+
+    case 'unblock':
+      return { ...lists, blocked: without(lists.blocked) }
+  }
+}
