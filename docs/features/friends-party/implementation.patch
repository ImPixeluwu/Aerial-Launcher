+  accountId,
+  partyId,
+}: {
+  accessToken: string
+  accountId: string
+  partyId: string
+}) {
+  return partyService.post(
+    `/parties/${partyId}/members/${accountId}/promote`,
+    {},
+    {
+      headers: {
+        Authorization: `bearer ${accessToken}`,
+      },
+    }
+  )
+}
+
+export function updateParty({
+  accessToken,
+  body,
+  partyId,
+}: {
+  accessToken: string
+  body: PartyPatchBody
+  partyId: string
+}) {
+  return partyService.patch(`/parties/${partyId}`, body, {
+    headers: {
+      Authorization: `bearer ${accessToken}`,
+    },
+  })
+}
