new file mode 100644
index 0000000..6df94e8
--- /dev/null
+++ b/src/routes/account-management/friends/-hooks.ts
@@ -0,0 +1,298 @@
+import type {
+  FriendsActionType,
+  FriendsEntry,
+  FriendsListType,
+  FriendsSummary,
+} from '../../../types/friends-list'
+
+import { useDeferredValue, useEffect, useMemo, useRef, useState } from 'react'
+import { useDebounce } from '@uidotdev/usehooks'
+import { useTranslation } from 'react-i18next'
+
+import {
+  friendsBulkDelay,
+  friendsSearchDelay,
+} from '../../../config/constants/friends'
+
+import { useGetSelectedAccount } from '../../../hooks/accounts'
+
+import { applyFriendsAction, filterFriends } from '../../../lib/parsers/friends'
+import { toast } from '../../../lib/notifications'
+
+export type FriendsBulkType = Extract<
+  FriendsActionType,
+  'remove' | 'accept' | 'reject' | 'cancel'
+>
+
+export type FriendsBulkState = {
+  type: FriendsBulkType
+  current: number
+  total: number
+  failed: number
+  stopping: boolean
+}
+
+/**
+ * List each bulk action runs on.
+ */
+export const friendsBulkListType: Record<FriendsBulkType, FriendsListType> = {
+  remove: 'friends',
+  accept: 'incoming',
+  reject: 'incoming',
+  cancel: 'outgoing',
+}
+
+function wait(time: number) {
+  return new Promise((resolve) => setTimeout(resolve, time))
+}
+
+export function useFriendsData() {
+  const { t } = useTranslation(['account-management'])
+  const { selected } = useGetSelectedAccount()
+
+  const [summary, setSummary] = useState<FriendsSummary | null>(null)
+  const [isLoading, setIsLoading] = useState(false)
+  const [tab, setTabState] = useState<FriendsListType>('friends')
+  const [searchValue, setSearchValue] = useState('')
+  const [addValue, setAddValue] = useState('')
+  const [isAdding, setIsAdding] = useState(false)
+  const [busyAccountId, setBusyAccountId] = useState<string | null>(null)
+  const [bulk, setBulk] = useState<FriendsBulkState | null>(null)
+
+  const loadRequest = useRef(0)
+  // Changes with the account: late responses of the previous one are dropped
+  const generation = useRef(0)
+  const stopBulkRequested = useRef(false)
+
+  const debouncedSearchValue = useDebounce(searchValue, friendsSearchDelay)
+
+  const playerName = (entry: Pick<FriendsEntry, 'displayName'>) =>
+    entry.displayName ?? t('friends.player')
+
+  const loadSummary = async () => {
+    if (!selected) {
+      return
+    }
+
+    const current = ++loadRequest.current
+
+    setIsLoading(true)
+
+    const result = await window.electronAPI.getFriendsSummary(selected)
+
+    if (current !== loadRequest.current) {
+      return
+    }
+
+    setSummary(result)
+    setIsLoading(false)
+  }
+
+  useEffect(() => {
+    generation.current += 1
+    loadRequest.current += 1
+    stopBulkRequested.current = true
+
+    setSummary(null)
+    setSearchValue('')
+    setBusyAccountId(null)
+    setBulk(null)
+    setIsAdding(false)
+    setIsLoading(false)
+
+    loadSummary()
+  }, [selected?.accountId])
+
+  const setTab = (value: FriendsListType) => {
+    setTabState(value)
+    setSearchValue('')
+  }
+
+  const runAction = async (type: FriendsActionType, entry: FriendsEntry) => {
+    if (!selected || busyAccountId !== null || bulk !== null) {
+      return
+    }
+
+    const currentGeneration = generation.current
+
+    setBusyAccountId(entry.accountId)
+
+    const response = await window.electronAPI.friendsAction(
+      selected,
+      type,
+      entry.accountId,
+    )
+
+    if (currentGeneration !== generation.current) {
+      return
+    }
+
+    setBusyAccountId(null)
+
+    if (!response.success) {
+      toast(t('friends.results.error', { error: response.error }))
+
+      return
+    }
+
+    if (type !== 'add') {
+      setSummary((current) =>
+        current
+          ? { ...current, ...applyFriendsAction(current, type, entry.accountId) }
+          : current,
+      )
+    }
+
+    toast(t(`friends.results.${type}`, { name: playerName(entry) }))
+  }
+
+  const addFriend = async () => {
+    const value = addValue.trim()
+
+    if (!selected || value === '' || isAdding || bulk !== null) {
+      return
+    }
+
+    const currentGeneration = generation.current
+
+    setIsAdding(true)
+
+    const response = await window.electronAPI.friendsAction(
+      selected,
+      'add',
+      value,
+    )
+
+    if (currentGeneration !== generation.current) {
+      return
+    }
+
+    setIsAdding(false)
+
+    if (!response.success) {
+      toast(t('friends.results.error', { error: response.error }))
+
+      return
+    }
+
+    setAddValue('')
+    toast(
+      t('friends.add.success', {
+        name: response.displayName ?? value,
+      }),
+    )
+    loadSummary()
+  }
+
+  /**
+   * One request per player, a second apart, on a snapshot of the list.
+   */
+  const runBulk = async (type: FriendsBulkType) => {
+    if (!selected || !summary || busyAccountId !== null || bulk !== null) {
+      return
+    }
+
+    const entries = summary[friendsBulkListType[type]]
+    const currentGeneration = generation.current
+    const isCurrent = () =>
+      currentGeneration === generation.current && !stopBulkRequested.current
+    let done = 0
+    let failed = 0
+
+    if (entries.length === 0) {
+      return
+    }
+
+    stopBulkRequested.current = false
+    setBulk({
+      type,
+      current: 0,
+      total: entries.length,
+      failed: 0,
+      stopping: false,
+    })
+
+    for (const [index, entry] of entries.entries()) {
+      if (index > 0) {
+        await wait(friendsBulkDelay)
+      }
+
+      if (!isCurrent()) {
+        break
+      }
+
+      const response = await window.electronAPI.friendsAction(
+        selected,
+        type,
+        entry.accountId,
+      )
+
+      if (currentGeneration !== generation.current) {
+        return
+      }
+
+      if (response.success) {
+        done += 1
+      } else {
+        failed += 1
+      }
+
+      setBulk((current) =>
+        current ? { ...current, current: index + 1, failed } : current,
+      )
+    }
+
+    if (currentGeneration !== generation.current) {
+      return
+    }
+
+    setBulk(null)
+    toast(
+      t(failed > 0 ? 'friends.bulk.done-with-errors' : 'friends.bulk.done', {
+        done,
+        failed,
+        total: entries.length,
+      }),
+    )
+    loadSummary()
+  }
+
+  const stopBulk = () => {
+    stopBulkRequested.current = true
+    setBulk((current) => (current ? { ...current, stopping: true } : current))
+  }
+
+  const tabEntries = summary?.[tab] ?? []
+  const filteredEntries = useMemo(
+    () => filterFriends(tabEntries, debouncedSearchValue),
+    [tabEntries, debouncedSearchValue],
+  )
+  const deferredEntries = useDeferredValue(filteredEntries)
+
+  return {
+    addValue,
+    bulk,
+    busyAccountId,
+    filteredEntries: deferredEntries,
+    isAdding,
+    isFiltering:
+      deferredEntries !== filteredEntries ||
+      searchValue !== debouncedSearchValue,
+    isLoading,
+    searchValue,
+    selected,
+    summary,
+    tab,
+    tabEntries,
+
+    addFriend,
+    loadSummary,
+    playerName,
+    runAction,
+    runBulk,
+    setAddValue,
+    setSearchValue,
+    setTab,
+    stopBulk,
+  }
+}
diff --git a/src/routes/account-management/friends/route.tsx b/src/routes/account-management/friends/route.tsx
new file mode 100644
index 0000000..d2d50e0
--- /dev/null
+++ b/src/routes/account-management/friends/route.tsx
@@ -0,0 +1,538 @@
+import type {
+  FriendsActionType,
+  FriendsEntry,
+  FriendsListType,
+} from '../../../types/friends-list'
+import type { FriendsBulkType } from './-hooks'
+
+import {
+  memo,
+  useCallback,
+  useEffect,
+  useLayoutEffect,
+  useRef,
+  useState,
+} from 'react'
+
+import { createRoute } from '@tanstack/react-router'
+import { useVirtualizer } from '@tanstack/react-virtual'
+import { UpdateIcon } from '@radix-ui/react-icons'
+import { Copy, Search, UserPlus, X } from 'lucide-react'
+import { useTranslation } from 'react-i18next'
+
+import { friendsListTypes } from '../../../config/constants/friends'
+
+import { Route as RootRoute } from '../../__root'
+
+import { HomeBreadcrumb } from '../../../components/navigations/breadcrumb/home'
+import {
+  Breadcrumb,
+  BreadcrumbItem,
+  BreadcrumbList,
+  BreadcrumbPage,
+  BreadcrumbSeparator,
+} from '../../../components/ui/breadcrumb'
+import { Button } from '../../../components/ui/button'
+import { useConfirmDialog } from '../../../components/ui/extended/confirm-dialog'
+import { Input } from '../../../components/ui/input'
+import { Tabs, TabsList, TabsTrigger } from '../../../components/ui/tabs'
+
+import { friendsBulkListType, useFriendsData } from './-hooks'
+
+import { toast } from '../../../lib/notifications'
+import { cn, parseCustomDisplayName } from '../../../lib/utils'
+
+export const Route = createRoute({
+  getParentRoute: () => RootRoute,
+  path: '/account-management/friends',
+  component: () => {
+    const { t } = useTranslation(['sidebar'])
+
+    return (
+      <>
+        <Breadcrumb>
+          <BreadcrumbList>
+            <HomeBreadcrumb />
+            <BreadcrumbSeparator />
+            <BreadcrumbItem>
+              <BreadcrumbPage>{t('account-management.title')}</BreadcrumbPage>
+            </BreadcrumbItem>
+            <BreadcrumbSeparator />
+            <BreadcrumbItem>
+              <BreadcrumbPage>
+                {t('account-management.options.friends')}
+              </BreadcrumbPage>
+            </BreadcrumbItem>
+          </BreadcrumbList>
+        </Breadcrumb>
+
+        <Content />
+      </>
+    )
+  },
+})
+
+/**
+ * Actions of each row, in order.
+ */
+const rowActions: Record<FriendsListType, Array<FriendsActionType>> = {
+  friends: ['remove', 'block'],
+  incoming: ['accept', 'reject'],
+  outgoing: ['cancel'],
+  blocked: ['unblock'],
+}
+
+const confirmedActions: Array<FriendsActionType> = [
+  'reject',
+  'cancel',
+  'remove',
+  'block',
+]
+
+const bulkActions: Record<FriendsListType, Array<FriendsBulkType>> = {
+  friends: ['remove'],
+  incoming: ['accept', 'reject'],
+  outgoing: ['cancel'],
+  blocked: [],
+}
+
+function Content() {
+  const { t } = useTranslation(['account-management'])
+  const { confirm, dialog } = useConfirmDialog()
+
+  const {
+    addValue,
+    bulk,
+    busyAccountId,
+    filteredEntries,
+    isAdding,
+    isFiltering,
+    isLoading,
+    searchValue,
+    selected,
+    summary,
+    tab,
+    tabEntries,
+
+    addFriend,
+    loadSummary,
+    playerName,
+    runAction,
+    runBulk,
+    setAddValue,
+    setSearchValue,
+    setTab,
+    stopBulk,
+  } = useFriendsData()
+
+  const accountName = parseCustomDisplayName(selected)
+
+  const handleAction = (type: FriendsActionType, entry: FriendsEntry) => {
+    if (!confirmedActions.includes(type)) {
+      runAction(type, entry)
+
+      return
+    }
+
+    confirm({
+      title: t(`friends.confirm.${type}.title`),
+      description: t(`friends.confirm.${type}.description`, {
+        name: playerName(entry),
+        account: accountName,
+      }),
+      confirmLabel: t(`friends.actions.${type}`),
+      cancelLabel: t('friends.confirm.keep'),
+      destructive: true,
+      onConfirm: () => runAction(type, entry),
+    })
+  }
+
+  // Rows keep the same callback, so they are not drawn again on each render
+  const actionRef = useRef(handleAction)
+  actionRef.current = handleAction
+  const onAction = useCallback(
+    (type: FriendsActionType, entry: FriendsEntry) =>
+      actionRef.current(type, entry),
+    [],
+  )
+
+  const handleBulk = (type: FriendsBulkType) => {
+    const count = summary?.[friendsBulkListType[type]].length ?? 0
+
+    confirm({
+      title: t(`friends.bulk.confirm.${type}.title`),
+      description: (
+        <>
+          <p>
+            {t(`friends.bulk.confirm.${type}.description`, {
+              count,
+              account: accountName,
+            })}
+          </p>
+          <p>{t('friends.bulk.confirm.note')}</p>
+        </>
+      ),
+      confirmLabel: t(`friends.bulk.${type}`),
+      cancelLabel: t('friends.confirm.keep'),
+      destructive: type !== 'accept',
+      onConfirm: () => runBulk(type),
+    })
+  }
+
+  if (!selected) {
+    return (
+      <div className="flex flex-grow items-center justify-center text-muted-foreground">
+        {t('friends.no-account')}
+      </div>
+    )
+  }
+
+  const isBusy = bulk !== null
+  const hasSearch = searchValue.trim() !== ''
+
+  return (
+    <div className="flex flex-col flex-grow gap-4">
+      <div className="flex items-center justify-between gap-4">
+        <p className="text-sm text-muted-foreground">
+          {t('friends.subtitle')}
+        </p>
+        <Button
+          size="icon"
+          variant="outline"
+          onClick={() => loadSummary()}
+          disabled={isLoading || isBusy}
+          title={t('friends.reload')}
+        >
+          <UpdateIcon className={cn({ 'animate-spin': isLoading })} />
+        </Button>
+      </div>
+
+      <form
+        className="flex gap-3"
+        onSubmit={(event) => {
+          event.preventDefault()
+          addFriend()
+        }}
+      >
+        <Input
+          className="flex-grow"
+          placeholder={t('friends.add.placeholder')}
+          value={addValue}
+          onChange={(event) => setAddValue(event.target.value)}
+          disabled={isAdding || isBusy}
+          spellCheck={false}
+        />
+        <Button
+          type="submit"
+          className="relative"
+          disabled={addValue.trim() === '' || isAdding || isBusy}
+        >
+          <span className={cn('absolute', { hidden: !isAdding })}>
+            <UpdateIcon className="animate-spin" />
+          </span>
+          <span className={cn('flex items-center', { invisible: isAdding })}>
+            <UserPlus className="size-4 mr-2" />
+            {t('friends.add.submit')}
+          </span>
+        </Button>
+      </form>
+
+      <Tabs
+        value={tab}
+        onValueChange={(value) => setTab(value as FriendsListType)}
+      >
+        <TabsList className="flex-wrap h-auto">
+          {friendsListTypes.map((type) => (
+            <TabsTrigger
+              key={type}
+              value={type}
+              disabled={isBusy}
+            >
+              {t(`friends.tabs.${type}`)}
+              <span className="ml-1.5 tabular-nums text-muted-foreground">
+                {summary?.[type].length ?? 0}
+              </span>
+            </TabsTrigger>
+          ))}
+        </TabsList>
+      </Tabs>
+
+      <div className="flex flex-wrap items-center gap-3">
+        <div className="relative flex-grow min-w-48">
+          <Search className="absolute left-2.5 top-2.5 size-4 text-muted-foreground" />
+          <Input
+            className="pl-8 pr-9"
+            placeholder={t('friends.search.placeholder')}
+            value={searchValue}
+            onChange={(event) => setSearchValue(event.target.value)}
+            spellCheck={false}
+          />
+          {searchValue !== '' && (
+            <Button
+              className="absolute right-0.5 top-0.5 size-9"
+              size="icon"
+              variant="ghost"
+              onClick={() => setSearchValue('')}
+              title={t('friends.search.clear')}
+            >
+              <X className="size-4" />
+            </Button>
+          )}
+        </div>
+        <span className="text-sm tabular-nums text-muted-foreground">
+          {t('friends.search.shown', {
+            shown: filteredEntries.length,
+            total: tabEntries.length,
+          })}
+        </span>
+        {bulkActions[tab].map((type) => (
+          <Button
+            key={type}
+            size="sm"
+            variant={type === 'accept' ? 'secondary' : 'outline'}
+            onClick={() => handleBulk(type)}
+            disabled={
+              isBusy || busyAccountId !== null || tabEntries.length === 0
+            }
+          >
+            {t(`friends.bulk.${type}`)}
+          </Button>
+        ))}
+      </div>
+
+      {bulk && (
+        <div
+          className="flex items-center gap-3 rounded-md border px-3 py-2 text-sm"
+          role="status"
+        >
+          <UpdateIcon className="animate-spin shrink-0" />
+          <span className="shrink-0">{t(`friends.bulk.${bulk.type}`)}</span>
+          <div className="h-2 flex-grow overflow-hidden rounded-full bg-muted">
+            <div
+              className="h-full bg-primary transition-[width]"
+              style={{
+                width: `${(bulk.current / Math.max(bulk.total, 1)) * 100}%`,
+              }}
+            />
+          </div>
+          <span className="shrink-0 tabular-nums">
+            {bulk.stopping
+              ? t('friends.bulk.stopping')
+              : t('friends.bulk.progress', {
+                  current: bulk.current,
+                  total: bulk.total,
+                })}
+          </span>
+          <Button
+            size="sm"
+            variant="outline"
+            onClick={stopBulk}
+            disabled={bulk.stopping}
+          >
+            {t('friends.bulk.stop')}
+          </Button>
+        </div>
+      )}
+
+      {summary && !summary.success ? (
+        <div className="flex items-center gap-3 border-l-4 border-red-400 ml-2 pl-2 text-red-400">
+          <span>
+            {t('friends.load-failed')}: {summary.error}
+          </span>
+          <Button
+            size="sm"
+            variant="outline"
+            onClick={() => loadSummary()}
+            disabled={isLoading}
+          >
+            {t('friends.retry')}
+          </Button>
+        </div>
+      ) : isLoading && !summary ? (
+        <div className="flex flex-grow items-center justify-center">
+          <UpdateIcon className="animate-spin size-6" />
+        </div>
+      ) : filteredEntries.length === 0 ? (
+        <div className="flex flex-col flex-grow items-center justify-center text-muted-foreground">
+          <p>
+            {hasSearch && tabEntries.length > 0
+              ? t('friends.empty.no-matches')
+              : t(`friends.empty.${tab}`)}
+          </p>
+        </div>
+      ) : (
+        <FriendsList
+          entries={filteredEntries}
+          isStale={isLoading || isFiltering}
+          actions={rowActions[tab]}
+          busyAccountId={busyAccountId}
+          disabled={isBusy || busyAccountId !== null}
+          onAction={onAction}
+        />
+      )}
+
+      {dialog}
+    </div>
+  )
+}
+
+// Fixed row height, so every row of the virtual list has the same size
+const rowHeight = 56
+
+/**
+ * Only the visible rows are rendered: accounts can have thousands of
+ * friends. The page scrolls in the main layout viewport.
+ */
+function FriendsList({
+  actions,
+  busyAccountId,
+  disabled,
+  entries,
+  isStale,
+  onAction,
+}: {
+  actions: Array<FriendsActionType>
+  busyAccountId: string | null
+  disabled: boolean
+  entries: Array<FriendsEntry>
+  isStale: boolean
+  onAction: (type: FriendsActionType, entry: FriendsEntry) => void
+}) {
+  const containerRef = useRef<HTMLDivElement>(null)
+  const [scrollMargin, setScrollMargin] = useState(0)
+  const [scrollElement] = useState(() =>
+    document.querySelector<HTMLElement>('.main-wrapper-content'),
+  )
+
+  const virtualizer = useVirtualizer({
+    count: entries.length,
+    getScrollElement: () => scrollElement,
+    estimateSize: () => rowHeight,
+    overscan: 8,
+    scrollMargin,
+  })
+
+  // The controls above the list change height as they wrap
+  useLayoutEffect(() => {
+    const offsetTop = containerRef.current?.offsetTop ?? 0
+
+    if (offsetTop !== scrollMargin) {
+      setScrollMargin(offsetTop)
+    }
+  })
+
+  // A new search or tab starts at the top of the list
+  useEffect(() => {
+    if (scrollElement && scrollElement.scrollTop > scrollMargin) {
+      scrollElement.scrollTop = scrollMargin
+    }
+  }, [entries])
+
+  return (
+    <div
+      ref={containerRef}
+      className={cn('relative w-full rounded-md border transition-opacity', {
+        'opacity-60': isStale,
+      })}
+      style={{ height: virtualizer.getTotalSize() }}
+    >
+      {virtualizer.getVirtualItems().map((row) => {
+        const entry = entries[row.index]
+
+        return (
+          <FriendRow
+            key={entry.accountId}
+            entry={entry}
+            actions={actions}
+            isBusy={busyAccountId === entry.accountId}
+            disabled={disabled}
+            isLast={row.index === entries.length - 1}
+            offset={row.start - scrollMargin}
+            onAction={onAction}
+          />
+        )
+      })}
+    </div>
+  )
+}
+
+const FriendRow = memo(function FriendRow({
+  actions,
+  disabled,
+  entry,
+  isBusy,
+  isLast,
+  offset,
+  onAction,
+}: {
+  actions: Array<FriendsActionType>
+  disabled: boolean
+  entry: FriendsEntry
+  isBusy: boolean
+  isLast: boolean
+  offset: number
+  onAction: (type: FriendsActionType, entry: FriendsEntry) => void
+}) {
+  const { t } = useTranslation(['account-management'])
+
+  const copyId = () => {
+    navigator.clipboard
+      .writeText(entry.accountId)
+      .then(() => toast(t('friends.copied')))
+      .catch(() => {})
+  }
+
+  return (
+    <div
+      className={cn(
+        'absolute left-0 top-0 flex w-full items-center gap-3 px-3',
+        { 'border-b': !isLast },
+      )}
+      style={{ height: rowHeight, transform: `translateY(${offset}px)` }}
+    >
+      <div className="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-sm font-medium uppercase text-muted-foreground">
+        {entry.displayName?.at(0) ?? '?'}
+      </div>
+      <div className="flex min-w-0 flex-grow flex-col">
+        <span
+          className={cn('truncate text-sm', {
+            'italic text-muted-foreground': entry.displayName === null,
+          })}
+        >
+          {entry.displayName ?? t('friends.player')}
+        </span>
+        <span className="flex items-center gap-1 text-xs text-muted-foreground">
+          <span className="truncate font-mono select-text">
+            {entry.accountId}
+          </span>
+          <button
+            type="button"
+            className="shrink-0 rounded p-0.5 hover:text-foreground"
+            onClick={copyId}
+            title={t('friends.copy-id')}
+            aria-label={t('friends.copy-id')}
+          >
+            <Copy className="size-3" />
+          </button>
+        </span>
+      </div>
+      <div className="flex shrink-0 items-center gap-2">
+        {isBusy && <UpdateIcon className="animate-spin" />}
+        {actions.map((type) => (
+          <Button
+            key={type}
+            size="sm"
+            className="h-8"
+            variant={
+              type === 'accept' || type === 'unblock' ? 'secondary' : 'outline'
+            }
+            onClick={() => onAction(type, entry)}
+            disabled={disabled}
+          >
+            {t(`friends.actions.${type}`)}
+          </Button>
+        ))}
+      </div>
+    </div>
+  )
+})
